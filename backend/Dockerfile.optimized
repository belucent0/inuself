# ==========================================
# Stage 1: Builder (빌드 의존성)
# ==========================================
FROM python:3.12-slim AS builder

WORKDIR /app

# 빌드 도구 설치 (이 레이어는 최종 이미지에 포함되지 않음)
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Deno 설치 (yt-dlp YouTube 다운로드에 필요, 2025.11.12 이후)
RUN curl -fsSL https://deno.land/install.sh | sh
ENV DENO_INSTALL="/root/.deno"
ENV PATH="${DENO_INSTALL}/bin:${PATH}"

# Poetry 설치
RUN pip install --no-cache-dir poetry==1.7.1

# Poetry 설정 (가상환경을 만들지 않음)
RUN poetry config virtualenvs.create false && \
    poetry config installer.max-workers 10

# 네트워크 타임아웃 환경변수 설정 (300초)
ENV POETRY_REQUESTS_TIMEOUT=300

# 의존성 파일 복사 및 설치
COPY pyproject.toml poetry.lock* ./
RUN poetry lock --no-update || poetry lock
RUN poetry install --no-interaction --no-ansi --no-root --without dev

# ==========================================
# Stage 2: Runtime (런타임 의존성만)
# ==========================================
FROM python:3.12-slim

WORKDIR /app

# 런타임 의존성만 설치 (빌드 도구 제외)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Deno를 builder에서 복사
COPY --from=builder /root/.deno /root/.deno
ENV DENO_INSTALL="/root/.deno"
ENV PATH="${DENO_INSTALL}/bin:${PATH}"

# Python 패키지를 builder에서 복사
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 애플리케이션 코드 복사
COPY . .

# 포트 노출
EXPOSE 8000

# 헬스체크를 위한 curl 확인 (ffmpeg에 포함된 curl 사용 불가하므로 추가)
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Alembic 마이그레이션 실행 후 서버 시작
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
