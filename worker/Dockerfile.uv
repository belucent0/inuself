# ==========================================
# Stage 1: Builder (빌드 의존성)
# ==========================================
FROM python:3.12-slim AS builder

WORKDIR /app

# 빌드 도구 설치
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# uv 설치 (Rust 기반 초고속 패키지 관리자, ~10MB)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Poetry 설치 (requirements.txt 생성용)
RUN pip install --no-cache-dir poetry

# 의존성 파일 복사 및 requirements.txt 생성
COPY worker/pyproject.toml worker/poetry.lock* ./
RUN poetry export -f requirements.txt --output requirements.txt --without-hashes --without dev

# uv로 초고속 의존성 설치
RUN uv pip install --system --no-cache -r requirements.txt

# ==========================================
# Stage 2: Runtime (런타임 의존성만)
# ==========================================
FROM python:3.12-slim

WORKDIR /app

# 런타임 의존성만 설치
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Python 패키지를 builder에서 복사
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 소스 코드 복사
COPY . .

# Celery Worker 실행
ENV PYTHONPATH=/app

CMD ["celery", "-A", "worker.celery_app", "worker", "--loglevel=info", "-Q", "asr_tasks,llm_summary,ocr_tasks"]
