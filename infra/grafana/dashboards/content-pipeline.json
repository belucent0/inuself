          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('hour', c.updated_at) AS time,\n  SUM(CASE WHEN f.content_type = 'AUDIO' AND c.status IN ('SUMMARY_QUEUED', 'SUMMARIZING', 'SUMMARY_FAILED', 'COMPLETED') THEN 1 ELSE 0 END) AS asr_count,\n  SUM(CASE WHEN f.content_type = 'DOCUMENT' AND c.status IN ('SUMMARY_QUEUED', 'SUMMARIZING', 'SUMMARY_FAILED', 'COMPLETED') THEN 1 ELSE 0 END) AS ocr_count,\n  SUM(CASE WHEN c.status = 'COMPLETED' THEN 1 ELSE 0 END) AS summary_count\nFROM content c\nJOIN file f ON f.id = c.file_id\nWHERE c.updated_at >= NOW() - INTERVAL '24 hours'\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "시간대별 처리량 (24시간)",
