        {
          "datasource": { "type": "postgres", "uid": "postgresql" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'ASR (오디오)' AS pipeline,\n  COALESCE(SUM(CASE WHEN c.status IN ('QUEUED', 'PULLING') THEN 1 ELSE 0 END), 0) AS queued,\n  COALESCE(SUM(CASE WHEN c.status = 'PROCESSING' THEN 1 ELSE 0 END), 0) AS processing,\n  COALESCE(SUM(CASE WHEN c.status IN ('SUMMARY_QUEUED', 'SUMMARIZING', 'SUMMARY_FAILED', 'COMPLETED') THEN 1 ELSE 0 END), 0) AS completed,\n  COALESCE(SUM(CASE WHEN c.status = 'ASR_FAILED' THEN 1 ELSE 0 END), 0) AS failed,\n  COALESCE(ROUND(AVG(CASE WHEN c.status IN ('SUMMARY_QUEUED', 'SUMMARIZING', 'SUMMARY_FAILED', 'COMPLETED') THEN EXTRACT(EPOCH FROM (c.updated_at - c.created_at)) / 60.0 END)::numeric, 1), 0) AS avg_min\nFROM content c\nJOIN file f ON f.id = c.file_id\nWHERE f.content_type = 'AUDIO'\nUNION ALL\nSELECT 'OCR (문서)' AS pipeline,\n  COALESCE(SUM(CASE WHEN c.status = 'QUEUED' THEN 1 ELSE 0 END), 0) AS queued,\n  COALESCE(SUM(CASE WHEN c.status = 'OCR_PROCESSING' THEN 1 ELSE 0 END), 0) AS processing,\n  COALESCE(SUM(CASE WHEN c.status IN ('SUMMARY_QUEUED', 'SUMMARIZING', 'SUMMARY_FAILED', 'COMPLETED') THEN 1 ELSE 0 END), 0) AS completed,\n  COALESCE(SUM(CASE WHEN c.status = 'OCR_FAILED' THEN 1 ELSE 0 END), 0) AS failed,\n  COALESCE(ROUND(AVG(CASE WHEN c.status IN ('SUMMARY_QUEUED', 'SUMMARIZING', 'SUMMARY_FAILED', 'COMPLETED') THEN EXTRACT(EPOCH FROM (c.updated_at - c.created_at)) / 60.0 END)::numeric, 1), 0) AS avg_min\nFROM content c\nJOIN file f ON f.id = c.file_id\nWHERE f.content_type = 'DOCUMENT'\nUNION ALL\nSELECT 'LLM 요약' AS pipeline,\n  COALESCE(SUM(CASE WHEN c.status = 'SUMMARY_QUEUED' THEN 1 ELSE 0 END), 0) AS queued,\n  COALESCE(SUM(CASE WHEN c.status = 'SUMMARIZING' THEN 1 ELSE 0 END), 0) AS processing,\n  COALESCE(SUM(CASE WHEN c.status = 'COMPLETED' THEN 1 ELSE 0 END), 0) AS completed,\n  COALESCE(SUM(CASE WHEN c.status = 'SUMMARY_FAILED' THEN 1 ELSE 0 END), 0) AS failed,\n  COALESCE(ROUND(AVG(CASE WHEN c.status = 'COMPLETED' THEN EXTRACT(EPOCH FROM (c.updated_at - c.created_at)) / 60.0 END)::numeric, 1), 0) AS avg_min\nFROM content c\nWHERE c.status IN ('SUMMARY_QUEUED', 'SUMMARIZING', 'SUMMARY_FAILED', 'COMPLETED');",
          "refId": "A"
        }
      ],
      "title": "파이프라인 현황",
      "type": "table"
